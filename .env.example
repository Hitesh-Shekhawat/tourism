# Copy to .env.local (development) or set in your host's environment (production).
# Only NEXT_PUBLIC_* values reach the browser. Everything else stays on the server.

# ── Site ──────────────────────────────────────────────────────────────────────────────
# The live domain, no trailing slash. Used for canonical URLs, the sitemap, robots.txt and
# Open Graph. The production build fails while this is unset.
NEXT_PUBLIC_SITE_URL=https://www.example-domain.in

# Preview builds only: lets `npm run build` finish while owner placeholders remain.
# Never set this for the production deployment.
# ALLOW_PLACEHOLDERS=true

# ── Enquiry delivery (Resend) ─────────────────────────────────────────────────────────
# Without all three, the form does NOT show success. It tells the guest to WhatsApp or
# call instead, and logs a server error.
RESEND_API_KEY=
# Where enquiries are sent (the business inbox)
ENQUIRY_TO_EMAIL=
# A sender on a domain verified in Resend, e.g. "Rajasthan Journeys <enquiries@your-domain.in>"
ENQUIRY_FROM_EMAIL=
# Optional: reply-to address on the guest's auto-reply (defaults to ENQUIRY_TO_EMAIL)
ENQUIRY_REPLY_TO_EMAIL=
# Optional: also POST each enquiry as JSON to a CRM / Google Apps Script (Sheets) / Zapier webhook
ENQUIRY_WEBHOOK_URL=
# Testing only: point the email API at a local mock server
# RESEND_API_BASE=http://localhost:4010

# ── Spam protection (Cloudflare Turnstile) ────────────────────────────────────────────
# Required in production: without the secret, production submissions are refused.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Analytics (optional) ──────────────────────────────────────────────────────────────
# GA4 measurement ID. When set, a consent banner appears and GA loads only after "Accept"
# (Consent Mode v2). When empty there is no banner and no tracking.
NEXT_PUBLIC_GA_ID=
